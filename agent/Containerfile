# The image an agent plays from: Python with pyautogui, xdotool, and x11-utils, able to
# screenshot and work the mouse and keyboard of the game's display, and `harness`, a minimal
# placeholder agent. An agent of your own can be built `FROM` it.
# pyautogui is installed without its declared dependencies, on python-xlib.

FROM docker.io/library/debian:trixie-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 python3-venv python3-tk scrot xdotool \
    x11-utils \
 && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/agent \
 && /opt/agent/bin/pip install --no-cache-dir --no-deps \
    pyautogui==0.9.54 pymsgbox==2.0.1 pytweening==1.2.0 pyscreeze==1.0.1 pygetwindow==0.0.9 \
    pyrect==0.2.0 mouseinfo==0.1.3 pyperclip==1.11.0 python-xlib==0.33 six==1.17.0 \
    pillow==12.3.0
ENV PATH=/opt/agent/bin:$PATH XDG_SESSION_TYPE=x11
COPY harness.py /usr/local/bin/harness
